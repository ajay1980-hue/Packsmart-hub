# Packsmart Ops server
NODE_ENV=production
PORT=8787

# Customer-zero admin login. Never commit real secrets.
PACKSMART_ADMIN_EMAIL=sales@packsmartsolutions.com
PACKSMART_ADMIN_PASSWORD=replace-me
SESSION_SECRET=replace-with-a-long-random-secret
CREDENTIALS_KEY=replace-with-a-separate-long-random-secret

# Optional cloud persistence. When omitted, the server uses a local JSON store for development only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Stripe subscription checkout.
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
APP_PUBLIC_URL=http://localhost:8787
