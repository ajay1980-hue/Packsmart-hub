# Packsmart Ops server
NODE_ENV=production
PORT=8787

# Customer-zero admin login. Never commit real secrets.
PACKSMART_ADMIN_EMAIL=sales@packsmartsolutions.com
PACKSMART_ADMIN_PASSWORD=replace-with-a-strong-temporary-bootstrap-password
OWNER_ACTIVATION_TOKEN=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
CREDENTIALS_KEY=replace-with-a-separate-at-least-32-character-secret
SESSION_TTL_SECONDS=43200
APP_PUBLIC_URL=https://packsmart-ops.onrender.com

# Optional cloud persistence. When omitted, the server uses a local JSON store for development only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional customer-zero environment fallback for read-only Shopify Admin GraphQL.
# Preferred production setup is the encrypted owner form inside Packsmart Ops.
SHOPIFY_ENV_WORKSPACE_ID=packsmart-solutions
SHOPIFY_STORE_DOMAIN=wavtzm-vy.myshopify.com
SHOPIFY_ADMIN_API_VERSION=2026-07
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Optional customer-zero environment fallback for the existing Packsmart eBay Manager.
# Preferred production setup is the encrypted owner form inside Packsmart Ops.
EBAY_ENV_WORKSPACE_ID=packsmart-solutions
EBAY_MANAGER_BASE_URL=
EBAY_MANAGER_API_TOKEN=
EBAY_EXPECTED_ACCOUNT=packsmartsolutions20

# Private beta and AI summarisation remain disabled for customer-zero.
BETA_SIGNUPS_ENABLED=false
AI_BRIEF_ENABLED=false

# Optional Stripe subscription checkout.
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
BILLING_CHECKOUT_ENABLED=false
