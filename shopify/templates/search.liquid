{{ 'search-packsmart.css' | asset_url | stylesheet_tag }}
<section class="search-hero"><div class="wrap"><h1>Search Packsmart</h1><form class="search-form" action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="SearchInput">Search products and pages</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search packaging, sizes or guidance" autocomplete="off"><button type="submit">Search</button></form></div></section><section class="search-page"><div class="wrap">{% if search.performed %}<p class="search-summary">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for “{{ search.terms | escape }}”</p>{% paginate search.results by 24 %}{% if search.results_count > 0 %}<div class="search-grid">{% for item in search.results %}{% assign result_alt = item.featured_image.alt | default: item.title %}<article class="search-card">{% if item.object_type == 'product' %}<a class="search-card-media" href="{{ item.url }}">{% if item.featured_image %}{{ item.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '220,420,640', alt: result_alt }}{% endif %}</a>{% endif %}<div class="search-card__body"><div class="search-card__type">{{ item.object_type | capitalize }}</div><h2><a href="{{ item.url }}">{{ item.title }}</a></h2>{% if item.object_type == 'product' %}<div class="search-card__price">{% if item.price_varies %}From {% endif %}{{ item.price | money }}</div>{% else %}<p>{{ item.content | strip_html | truncatewords: 24 }}</p>{% endif %}</div></article>{% endfor %}</div>{% else %}<div class="search-empty"><h2>No matches found</h2><p>Try a broader term such as “bubble”, “foam”, “mailing bag” or “pouch”.</p><a class="btn primary" href="{{ routes.all_products_collection_url }}">Browse all products</a></div>{% endif %}{% if paginate.pages > 1 %}<nav class="premium-pagination" aria-label="Search pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}{% else %}<div class="search-empty"><h2>What are you looking for?</h2><p>Search our product range and packaging guidance.</p></div>{% endif %}</div></section>
