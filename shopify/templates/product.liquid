{% assign ps_quote_required = false %}{% if product.tags contains 'quote-required' or product.tags contains 'delivery:two-metre-freight' %}{% assign ps_quote_required = true %}{% endif %}
{% assign ps_stocked = false %}{% if product.tags contains 'stocked' or product.tags contains 'Stocked' or product.tags contains 'stock-held' or product.tags contains 'fast-dispatch' %}{% assign ps_stocked = true %}{% endif %}
{% assign ps_trade_item = false %}{% if product.tags contains 'Trade' or product.tags contains 'trade' %}{% assign ps_trade_item = true %}{% endif %}
{{ 'product-packsmart.css' | asset_url | stylesheet_tag }}
<section class="product-page"><div class="wrap"><nav class="product-breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span>{% if collection %}<a href="{{ collection.url }}">{{ collection.title }}</a><span aria-hidden="true">›</span>{% endif %}<span>{{ product.title }}</span></nav><div class="product-layout"><div class="product-gallery"><div class="product-main-image">{% if product.featured_image %}<img id="ProductMainImage" src="{{ product.featured_image | image_url: width: 1400 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="1400" height="1400" loading="eager" fetchpriority="high">{% else %}<div class="product-image-placeholder">Image coming soon</div>{% endif %}{% unless product.available %}<span class="product-gallery__badge">Sold out</span>{% else %}{% if ps_quote_required %}<span class="product-gallery__badge product-gallery__badge--quote">Delivery quote</span>{% elsif ps_stocked %}<span class="product-gallery__badge product-gallery__badge--stock">Fast despatch</span>{% else %}<span class="product-gallery__badge">Available to order</span>{% endif %}{% endunless %}</div>{% if product.images.size > 1 %}<div class="product-thumbs" aria-label="Product images">{% for image in product.images %}{% assign thumb_alt = image.alt | default: product.title %}<button class="product-thumb{% if image == product.featured_image %} is-active{% endif %}" type="button" data-product-image="{{ image | image_url: width: 1400 }}" data-product-alt="{{ image.alt | default: product.title | escape }}" aria-label="View image {{ forloop.index }}">{{ image | image_url: width: 240 | image_tag: loading: 'lazy', alt: thumb_alt }}</button>{% endfor %}</div>{% endif %}</div><div class="product-details"><div class="product-details__eyebrow">{{ product.type | default: 'Protective packaging' }}</div><h1>{{ product.title }}</h1>
{% assign selected_unit_label = '' %}{% assign selected_variant_title = product.selected_or_first_available_variant.title %}{% if selected_variant_title contains 'Pack of ' %}{% assign selected_pack_count = selected_variant_title | remove: 'Pack of ' | plus: 0 %}{% if selected_pack_count > 0 %}{% assign selected_unit_price = product.selected_or_first_available_variant.price | divided_by: selected_pack_count %}{% capture selected_unit_label %}{{ selected_unit_price | money }} each{% endcapture %}{% endif %}{% elsif product.type == 'Foam Rolls' and selected_variant_title contains 'm' %}{% assign selected_metres = selected_variant_title | remove: 'm' | plus: 0 %}{% if selected_metres > 0 %}{% assign selected_unit_price = product.selected_or_first_available_variant.price | divided_by: selected_metres %}{% capture selected_unit_label %}{{ selected_unit_price | money }} per metre{% endcapture %}{% endif %}{% endif %}
<div class="product-price" id="ProductPrice">{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}<del>{{ product.selected_or_first_available_variant.compare_at_price | money }}</del>{% endif %}{{ product.selected_or_first_available_variant.price | money }}</div><div class="product-unit-price" id="ProductUnitPrice"{% if selected_unit_label == blank %} hidden{% endif %}>{{ selected_unit_label }}</div>
<div class="product-delivery" aria-label="Fulfilment information">{% if ps_quote_required %}<span>Freight quote required</span><span>Two-metre / pallet delivery</span><span>Trade supply</span>{% elsif ps_stocked %}<span>In stock</span><span>Fast UK despatch</span><span>Exact rate at checkout</span>{% else %}<span>Supplier-backed range</span><span>1–2 working day despatch</span><span>Exact rate at checkout</span>{% endif %}</div>{% if ps_quote_required %}<p class="product-shipping-note">This bulky trade product requires a separate freight or pallet delivery quotation. Standard parcel delivery is not suitable.</p>{% else %}<p class="product-shipping-note">Delivery is calculated using the product’s packed shipping class. Larger mixed and multi-carton orders may be reviewed before despatch.</p>{% endif %}
{% unless product.available %}<div class="product-status product-status--sold"><span class="product-status__dot" aria-hidden="true"></span><span>Currently unavailable</span></div>{% else %}{% if ps_quote_required %}<div class="product-status product-status--quote"><span class="product-status__dot" aria-hidden="true"></span><span><strong>Delivery quote required.</strong> This product is supplied to order and will not use standard parcel checkout.</span></div>{% elsif ps_stocked %}<div class="product-status product-status--stocked"><span class="product-status__dot" aria-hidden="true"></span><span><strong>In stock — fast despatch.</strong> Ready to be packed and sent from Packsmart stock.</span></div>{% elsif ps_trade_item %}<div class="product-status"><span class="product-status__dot" aria-hidden="true"></span><span><strong>Trade item — supplied to order.</strong> We aim to despatch within 1–2 working days.</span></div>{% else %}<div class="product-status"><span class="product-status__dot" aria-hidden="true"></span><span><strong>Available to order.</strong> We aim to despatch within 1–2 working days.</span></div>{% endif %}{% endunless %}
{% if product.description != blank %}<div class="product-description rte">{{ product.description }}</div>{% endif %}<nav class="product-help-links" aria-label="Product help"><a href="/pages/packaging-size-guide">Check the size guide</a><a href="/pages/delivery-returns">Delivery &amp; returns</a><a href="/pages/contact">Ask a product question</a></nav>
{% if ps_quote_required and product.available %}<div class="product-quote-box"><h2>Request your delivery price</h2><p>Send the delivery postcode and required quantity. Packsmart will confirm the most suitable two-metre, pallet or trade-freight option before you place the order.</p><div class="product-quote-box__actions"><a class="btn primary" href="/pages/request-a-quote?product={{ product.handle | url_encode }}">Request delivery quote</a><a class="btn secondary" href="/pages/contact">Contact Packsmart</a></div></div>{% else %}<form class="product-form" method="post" action="{{ routes.cart_add_url }}" enctype="multipart/form-data">{% if product.has_only_default_variant %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endif %}{% unless product.has_only_default_variant %}<div class="product-form__group"><label for="ProductVariant">Choose option</label><select id="ProductVariant" name="id">{% for variant in product.variants %}{% assign unit_label = '' %}{% if variant.title contains 'Pack of ' %}{% assign pack_count = variant.title | remove: 'Pack of ' | plus: 0 %}{% if pack_count > 0 %}{% assign unit_price = variant.price | divided_by: pack_count %}{% capture unit_label %}{{ unit_price | money }} each{% endcapture %}{% endif %}{% elsif product.type == 'Foam Rolls' and variant.title contains 'm' %}{% assign metre_count = variant.title | remove: 'm' | plus: 0 %}{% if metre_count > 0 %}{% assign unit_price = variant.price | divided_by: metre_count %}{% capture unit_label %}{{ unit_price | money }} per metre{% endcapture %}{% endif %}{% endif %}<option value="{{ variant.id }}" data-unit-label="{{ unit_label | escape }}" data-price="{{ variant.price | money | escape }}" data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"{% if variant == product.selected_or_first_available_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select></div>{% endunless %}<div class="product-form__row"><div class="product-form__group product-form__group--flush"><label for="ProductQuantity">Number of packs</label><input id="ProductQuantity" type="number" name="quantity" value="1" min="1" inputmode="numeric"></div><button class="product-form__submit" type="submit"{% unless product.available %} disabled{% endunless %}>{% if product.available %}Add to basket{% else %}Sold out{% endif %}</button></div></form>{% endif %}
<div class="product-assurance"><div class="product-assurance__item"><strong>Fast despatch</strong>We aim to despatch in-stock orders within 1–2 working days</div><div class="product-assurance__item"><strong>Secure checkout</strong>Exact delivery options are shown before payment</div><div class="product-assurance__item"><strong>Need help?</strong>Use the size guide or contact Packsmart before ordering</div></div></div></div></div></section>
<section class="product-related" aria-labelledby="RelatedProductsTitle"><div class="wrap"><div class="product-related__head"><h2 id="RelatedProductsTitle">You may also need</h2><a href="/collections/best-sellers">View all best sellers</a></div><div class="product-related__grid">{% assign related_count = 0 %}{% for related_product in collections['best-sellers'].products %}{% if related_product.id != product.id and related_product.available %}<article class="product-related__card"><a class="product-related__media" href="{{ related_product.url }}">{% if related_product.featured_image %}{{ related_product.featured_image | image_url: width: 520 | image_tag: loading: 'lazy', alt: related_product.title }}{% endif %}</a><div class="product-related__body"><h3><a href="{{ related_product.url }}">{{ related_product.title }}</a></h3><strong>{% if related_product.price_varies %}From {% endif %}{{ related_product.price | money }}</strong></div></article>{% assign related_count = related_count | plus: 1 %}{% if related_count == 4 %}{% break %}{% endif %}{% endif %}{% endfor %}</div></div></section>
