{{ 'cart-packsmart.css' | asset_url | stylesheet_tag }}
{% assign free_delivery_threshold = 2500 %}
{% assign standard_delivery_price = 349 %}
{% assign cart_requires_quote = false %}
{% for item in cart.items %}
  {% if item.product.tags contains 'quote-required' or item.product.tags contains 'delivery:two-metre-freight' %}
    {% assign cart_requires_quote = true %}
    {% break %}
  {% endif %}
{% endfor %}

<section class="cart-hero">
  <div class="wrap">
    <h1>Your basket</h1>
  </div>
</section>

<section class="cart-page">
  <div class="wrap">
    {% if cart.item_count > 0 %}
      {% assign qualifies_for_free_delivery = false %}
      {% if cart.total_price >= free_delivery_threshold %}
        {% assign qualifies_for_free_delivery = true %}
      {% endif %}
      {% assign free_delivery_remaining = free_delivery_threshold | minus: cart.total_price %}
      {% assign free_delivery_progress = cart.total_price | times: 100 | divided_by: free_delivery_threshold | at_most: 100 %}
      {% assign estimated_total = cart.total_price %}
      {% unless qualifies_for_free_delivery or cart_requires_quote %}
        {% assign estimated_total = estimated_total | plus: standard_delivery_price %}
      {% endunless %}

      <form action="{{ routes.cart_url }}" method="post">
        <div class="cart-layout">
          <div>
            <div class="cart-lines">
              {% for item in cart.items %}
                {% assign cart_image_alt = item.image.alt | default: item.product.title %}
                <div class="cart-line">
                  <a class="cart-line__image" href="{{ item.url }}">
                    {% if item.image %}
                      {{ item.image | image_url: width: 360 | image_tag: loading: 'lazy', alt: cart_image_alt }}
                    {% endif %}
                  </a>
                  <div>
                    <h2 class="cart-line__title"><a href="{{ item.url }}">{{ item.product.title }}</a></h2>
                    {% unless item.product.has_only_default_variant %}
                      <p class="cart-line__meta">{{ item.variant.title }}</p>
                    {% endunless %}
                    {% for property in item.properties %}
                      {% assign first_character = property.first | slice: 0 %}
                      {% unless property.last == blank or first_character == '_' %}
                        <p class="cart-line__meta">{{ property.first }}: {{ property.last }}</p>
                      {% endunless %}
                    {% endfor %}
                    <a class="cart-line__remove" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">Remove</a>
                  </div>
                  <div class="cart-line__qty">
                    <label for="CartQuantity-{{ forloop.index }}">Quantity</label>
                    <input id="CartQuantity-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
                  </div>
                  <div class="cart-line__total">{{ item.final_line_price | money }}</div>
                </div>
              {% endfor %}
            </div>

            <div class="cart-actions">
              <a class="btn secondary" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
              <button class="btn secondary" type="submit" name="update">Update basket</button>
            </div>
          </div>

          <aside class="cart-summary" aria-labelledby="CartSummaryTitle">
            <h2 id="CartSummaryTitle">Order summary</h2>
            <div class="cart-summary__row">
              <span>Items</span>
              <strong>{{ cart.item_count }}</strong>
            </div>
            <div class="cart-summary__row">
              <span>Subtotal</span>
              <strong>{{ cart.total_price | money }}</strong>
            </div>

            <div class="cart-summary__row cart-summary__row--delivery">
              <span>
                Standard UK delivery
                <small>Eligible UK parcel orders</small>
              </span>
              {% if cart_requires_quote %}
                <strong>Quote required</strong>
              {% elsif qualifies_for_free_delivery %}
                <strong class="cart-summary__delivery--free">FREE</strong>
              {% else %}
                <strong>{{ standard_delivery_price | money }}</strong>
              {% endif %}
            </div>

            {% unless cart_requires_quote %}
              <div class="cart-summary__row cart-summary__row--estimate">
                <span>Estimated total</span>
                <strong class="cart-summary__estimate-total">{{ estimated_total | money }}</strong>
              </div>

              <div
                class="cart-progress"
                style="--cart-progress:{{ free_delivery_progress }}%"
                role="progressbar"
                aria-label="Progress towards free UK standard delivery"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="{{ free_delivery_progress }}"
              >
                <div class="cart-progress__text">
                  {% if free_delivery_remaining > 0 %}
                    <span>Add <strong>{{ free_delivery_remaining | money }}</strong> to get free UK delivery</span>
                    <span aria-hidden="true">{{ free_delivery_progress }}%</span>
                  {% else %}
                    <span><strong>Free UK delivery unlocked</strong></span>
                    <span aria-hidden="true">✓</span>
                  {% endif %}
                </div>
                <div class="cart-progress__track" aria-hidden="true">
                  <span class="cart-progress__bar"></span>
                </div>
              </div>
            {% endunless %}

            <div class="cart-shipping">
              {% if cart_requires_quote %}
                <p class="cart-shipping__headline">
                  <svg class="cart-shipping__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7zM6.5 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm11 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                  Delivery quote required
                </p>
                <small class="cart-shipping__small">This basket includes a bulky, long foam or pallet item. Packsmart will confirm the carriage price before you place the order.</small>
              {% elsif qualifies_for_free_delivery %}
                <p class="cart-shipping__headline cart-shipping__headline--success">
                  <svg class="cart-shipping__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7zM6.5 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm11 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                  Your basket qualifies for free UK standard delivery
                </p>
                <small class="cart-shipping__small">Postcode and product eligibility are confirmed at checkout. Bulky, long foam and pallet items are quoted separately.</small>
              {% else %}
                <p class="cart-shipping__headline">
                  <svg class="cart-shipping__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7zM6.5 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm11 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                  UK standard delivery is {{ standard_delivery_price | money }}
                </p>
                <small class="cart-shipping__small">Free on eligible orders of {{ free_delivery_threshold | money }} or more. Postcode and product eligibility are confirmed at checkout; bulky, long foam and pallet items are quoted separately.</small>
              {% endif %}
            </div>

            <p class="cart-summary__note">Order before 2pm for target next-working-day dispatch when in stock.</p>

            <div class="cart-help">
              <a href="/pages/delivery-returns">Read delivery &amp; returns</a>
              <a href="/pages/contact">Need help before checkout?</a>
            </div>

            {% if cart_requires_quote %}
              <a class="btn primary cart-checkout" href="/pages/request-a-quote">Request delivery quote</a>
              <p class="cart-checkout__reassurance">Carriage is agreed before the order is placed.</p>
            {% else %}
              <button class="btn primary cart-checkout" type="submit" name="checkout">Continue to secure checkout</button>
              <p class="cart-checkout__reassurance">Delivery shown before payment · Secure checkout</p>
            {% endif %}
          </aside>
        </div>
      </form>
    {% else %}
      <div class="cart-empty">
        <h2>Your basket is empty</h2>
        <p>Choose exactly what you need—from small starter packs to larger multipacks.</p>
        <p class="cart-empty__shipping">UK standard delivery £3.49 · Free on eligible orders £25+ · No minimum order</p>
        <a class="btn primary" href="{{ routes.all_products_collection_url }}">Shop packaging</a>
      </div>
    {% endif %}
  </div>
</section>
