{{ 'cart-packsmart.css' | asset_url | stylesheet_tag }}
<section class="cart-hero"><div class="wrap"><h1>Your basket</h1></div></section><section class="cart-page"><div class="wrap">{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><div class="cart-layout"><div><div class="cart-lines">{% for item in cart.items %}{% assign cart_image_alt = item.image.alt | default: item.product.title %}<div class="cart-line"><a class="cart-line__image" href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 360 | image_tag: loading: 'lazy', alt: cart_image_alt }}{% endif %}</a><div><h2 class="cart-line__title"><a href="{{ item.url }}">{{ item.product.title }}</a></h2>{% unless item.product.has_only_default_variant %}<p class="cart-line__meta">{{ item.variant.title }}</p>{% endunless %}{% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% unless property.last == blank or first_character == '_' %}<p class="cart-line__meta">{{ property.first }}: {{ property.last }}</p>{% endunless %}{% endfor %}<a class="cart-line__remove" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">Remove</a></div><div class="cart-line__qty"><label for="CartQuantity-{{ forloop.index }}">Quantity</label><input id="CartQuantity-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric"></div><div class="cart-line__total">{{ item.final_line_price | money }}</div></div>{% endfor %}</div><div class="cart-actions"><a class="btn secondary" href="{{ routes.all_products_collection_url }}">Continue shopping</a><button class="btn secondary" type="submit" name="update">Update basket</button></div></div><aside class="cart-summary"><h2>Order summary</h2><div class="cart-summary__row"><span>Items</span><strong>{{ cart.item_count }}</strong></div><div class="cart-summary__row"><span>Subtotal</span><strong class="cart-summary__total">{{ cart.total_price | money }}</strong></div>{% assign free_delivery_threshold = 5000 %}{% assign free_delivery_remaining = free_delivery_threshold | minus: cart.total_price %}{% assign free_delivery_progress = cart.total_price | times: 100 | divided_by: free_delivery_threshold | at_most: 100 %}<div class="cart-progress" style="--cart-progress:{{ free_delivery_progress }}%"><div class="cart-progress__text">{% if free_delivery_remaining > 0 %}<span>Add <strong>{{ free_delivery_remaining | money }}</strong> for eligible free UK standard delivery</span><span>{{ free_delivery_progress }}%</span>{% else %}<span><strong>Eligible free UK standard delivery unlocked</strong></span><span>✓</span>{% endif %}</div><div class="cart-progress__track" aria-hidden="true"><span class="cart-progress__bar"></span></div></div><div class="cart-shipping"><p class="cart-shipping__headline"><svg class="cart-shipping__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7zM6.5 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm11 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>Delivery is calculated from the packed weight and shipping class of your basket.</p><small class="cart-shipping__small">Standard parcels and foam rolls use separate UK rates. Larger mixed or multi-carton orders may have additional delivery options confirmed before despatch.</small><span class="cart-shipping__retail">Eligible orders of £50 or more receive free UK standard delivery.</span></div><p class="cart-summary__note">Your exact available delivery options are confirmed at checkout. We aim to despatch in-stock orders within 1–2 working days.</p><div class="cart-help"><a href="/pages/delivery-returns">Read delivery &amp; returns</a><a href="/pages/contact">Need help before checkout?</a></div><button class="btn primary" type="submit" name="checkout">Secure checkout</button></aside></div></form>{% else %}<div class="cart-empty"><h2>Your basket is empty</h2><p>Choose exactly what you need—from small starter packs to larger multipacks.</p><p class="cart-empty__shipping">UK delivery from £3.99 · Calculated by packed weight · No minimum order</p><a class="btn primary" href="{{ routes.all_products_collection_url }}">Shop packaging</a></div>{% endif %}</div></section>
