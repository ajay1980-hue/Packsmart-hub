{{ 'collection-packsmart.css' | asset_url | stylesheet_tag }}
<section class="collection-hero"><div class="wrap"><div class="collection-hero__eyebrow">Shop the range</div><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="collection-hero__description rte">{{ collection.description }}</div>{% endif %}</div></section>
<nav class="collection-shortcuts" aria-label="Shop by packaging type"><div class="wrap collection-shortcuts__links"><a href="/collections/mailing-bags">Mailing bags</a><a href="/collections/bubble-envelopes">Bubble envelopes</a><a href="/collections/bubble-pouches">Bubble pouches</a><a href="/collections/foam-wrap-protection">Foam wrap</a><a href="/pages/packaging-size-guide">Not sure? Open size guide</a></div></nav>
<section class="collection-page"><div class="wrap">{% paginate collection.products by 24 %}<div class="collection-toolbar"><span>{{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}</span><form method="get"><label for="sort-by" class="visually-hidden">Sort products</label><select id="sort-by" name="sort_by" data-sort-select>{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></form></div>{% if collection.products.size > 0 %}<div class="collection-grid">{% for product in collection.products %}{% assign card_quote = false %}{% if product.tags contains 'quote-required' or product.tags contains 'delivery:two-metre-freight' %}{% assign card_quote = true %}{% endif %}{% assign card_stocked = false %}{% if product.tags contains 'stocked' or product.tags contains 'Stocked' or product.tags contains 'stock-held' or product.tags contains 'fast-dispatch' %}{% assign card_stocked = true %}{% endif %}{% assign card_trade = false %}{% if product.tags contains 'Trade' or product.tags contains 'trade' %}{% assign card_trade = true %}{% endif %}{% assign card_alt = product.featured_image.alt | default: product.title %}<article class="collection-card"><a class="collection-card__media" href="{{ product.url | within: collection }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '260,420,560,720', alt: card_alt }}{% else %}<div class="collection-card__placeholder">Image coming soon</div>{% endif %}{% unless product.available %}<span class="collection-card__badge">Sold out</span>{% else %}{% if card_quote %}<span class="collection-card__badge collection-card__badge--quote">Delivery quote</span>{% elsif card_stocked %}<span class="collection-card__badge collection-card__badge--stock">Fast despatch</span>{% else %}<span class="collection-card__badge">Available to order</span>{% endif %}{% endunless %}</a><div class="collection-card__body"><h2 class="collection-card__title"><a href="{{ product.url | within: collection }}">{{ product.title }}</a></h2><p class="collection-card__type">{{ product.type | default: 'Protective packaging' }}</p>{% if product.available %}{% if card_quote %}<p class="collection-card__fulfilment">Supplied to order — separate freight or pallet delivery quote required.</p>{% elsif card_stocked %}<p class="collection-card__fulfilment collection-card__fulfilment--stock">In stock — ready for fast UK despatch.</p>{% elsif card_trade %}<p class="collection-card__fulfilment">Trade item — typically despatched within 3–5 working days.</p>{% else %}<p class="collection-card__fulfilment">Available to order — typically despatched within 3–5 working days.</p>{% endif %}{% endif %}<div class="collection-card__price">{% if product.price_varies %}From {% endif %}{{ product.price | money }}</div><div class="collection-card__actions">{% if card_quote and product.available %}<a class="btn primary" href="{{ product.url | within: collection }}">View &amp; request quote</a>{% elsif product.available and product.has_only_default_variant %}<form method="post" action="{{ routes.cart_add_url }}"><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button class="btn primary" type="submit">Add to basket</button></form>{% else %}<a class="btn secondary" href="{{ product.url | within: collection }}">{% if product.available %}Choose options{% else %}View product{% endif %}</a>{% endif %}</div></div></article>{% endfor %}</div>{% else %}<div class="collection-empty"><h2>No products found</h2><p>There are currently no products in this collection.</p><a class="btn primary" href="{{ routes.all_products_collection_url }}">View all products</a></div>{% endif %}{% if paginate.pages > 1 %}<nav class="premium-pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}</div></section>
