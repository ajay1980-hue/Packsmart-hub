<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#050607">
  {% assign seo_title = page_title | default: shop.name %}
  {% assign seo_description = page_description %}
  {% if seo_description == blank %}
    {% case request.page_type %}
      {% when 'product' %}{% assign seo_description = product.description | strip_html %}
      {% when 'collection' %}{% assign seo_description = collection.description | strip_html %}
      {% when 'page' %}{% assign seo_description = page.content | strip_html %}
    {% endcase %}
  {% endif %}
  {% assign seo_description = seo_description | default: shop.description | default: 'Protective packaging in practical pack sizes from Packsmart Solutions Ltd.' %}
  <title>{{ seo_title }}{% unless seo_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
  <meta name="description" content="{{ seo_description | strip_html | strip_newlines | truncate: 160 | escape }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {% if request.page_type == 'search' or request.page_type == '404' %}<meta name="robots" content="noindex,follow">{% endif %}
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ seo_title | escape }}">
  <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
  <meta property="og:description" content="{{ seo_description | strip_html | strip_newlines | truncate: 200 | escape }}">
  {% if page_image %}<meta property="og:image" content="{{ page_image | image_url: width: 1200 | prepend: 'https:' }}">{% endif %}
  <meta name="twitter:card" content="{% if page_image %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{{ seo_title | escape }}">
  <meta name="twitter:description" content="{{ seo_description | strip_html | strip_newlines | truncate: 200 | escape }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  {{ content_for_header }}
  <link rel="preload" href="{{ 'styles.css' | asset_url }}" as="style">
  {{ 'styles.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'site.js' | asset_url }}" defer></script>
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":{{ shop.name | json }},"url":{{ shop.url | json }},"sameAs":["https://www.facebook.com/share/1KYm69ht9X/","https://www.instagram.com/packsmartsolutions/","https://www.tiktok.com/@packsmartsolutions","https://www.linkedin.com/company/packsmart-solutions-ltd/"]}</script>
  {% if request.page_type == 'product' %}<script type="application/ld+json">{{ product | structured_data }}</script>{% endif %}
</head>
<body class="template-{{ template.name | handle }}">
  <a class="skip-link" href="#MainContent">Skip to content</a>
  {% section 'topbar' %}
  {% section 'header' %}
  <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
  {% section 'footer' %}
  {% render 'packsmart-assistant' %}
</body>
</html>
