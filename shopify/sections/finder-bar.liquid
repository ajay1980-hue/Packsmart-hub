<section class="finder-section" aria-labelledby="FinderTitle">
  <div class="wrap finder-bar">
    <div class="finder-intro">
      <svg class="finder-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="M24 3 42 13v22L24 45 6 35V13L24 3Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="m16 24 5 5 11-12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <div><p class="finder-eyebrow">Packaging Finder</p><h2 id="FinderTitle">Start with what you are packing</h2><p>Choose the closest use case and size. We’ll point you to a real Packsmart product as a practical starting point.</p></div>
    </div>
    <div class="finder-fields">
      <div class="field"><label for="sendType">What are you packing?</label><select id="sendType"><option>Clothing</option><option>Books &amp; media</option><option>Small accessories</option><option>Delicate components</option></select></div>
      <div class="field"><label for="itemSize">Approximate size</label><select id="itemSize"><option>Small</option><option selected>Medium</option><option>Large</option></select></div>
      <div class="field"><label for="quantity">Order pattern</label><select id="quantity"><option>Single / occasional</option><option>Regular ecommerce</option><option>Bulk / repeat</option></select></div>
      <button class="btn primary finder-submit" type="button" data-finder-submit>Show my options</button>
      <div id="finderResult" class="finder-note" aria-live="polite">Choose your answers to get a product recommendation.</div>
    </div>
  </div>
</section>