{% assign bubble_pouches = collections['bubble-pouches'] %}
{% assign bubble_envelopes = collections['bubble-envelopes'] %}
{% assign mailing_bags = collections['mailing-bags'] %}
{% assign foam_protection = collections['foam-wrap-protection'] %}
{% assign about_page = pages['about-us'] %}
{% assign guide_page = pages['packaging-size-guide'] %}
{% assign faq_page = pages['faq'] %}
{% assign returns_page = pages['refund-returns-policy'] %}
{% assign contact_page = pages['contact'] %}
{% assign delivery_page = pages['delivery-returns'] %}
{% assign help_page = pages['request-a-quote'] %}
{% assign samples_page = pages['request-samples'] %}
{% assign terms_page = pages['terms-of-service'] %}
<footer class="premium-footer"><div class="wrap"><div class="premium-footer__grid"><div class="premium-footer__brand"><a class="premium-footer__logo" href="{{ routes.root_url }}" aria-label="Packsmart Solutions home"><picture><source media="(max-width:640px)" srcset="https://cdn.shopify.com/s/files/1/1059/3917/3710/files/packsmart-3d-header-mobile.webp?v=1785447702"><img src="https://cdn.shopify.com/s/files/1/1059/3917/3710/files/packsmart-3d-header-desktop.webp?v=1785447686" alt="Packsmart Solutions Ltd" width="1600" height="363" loading="lazy"></picture></a><p>Protective packaging for online selling, home use and everyday sending.</p></div><nav class="premium-footer__links" aria-labelledby="FooterShopTitle-{{ section.id }}"><h2 id="FooterShopTitle-{{ section.id }}">Shop</h2><a href="{{ routes.all_products_collection_url }}">All Products</a>{% if bubble_pouches != blank %}<a href="{{ bubble_pouches.url }}">Bubble Pouches</a>{% endif %}{% if bubble_envelopes != blank %}<a href="{{ bubble_envelopes.url }}">Bubble Envelopes</a>{% endif %}{% if mailing_bags != blank %}<a href="{{ mailing_bags.url }}">Mailing Bags</a>{% endif %}{% if foam_protection != blank %}<a href="{{ foam_protection.url }}">Foam Protection</a>{% endif %}</nav><nav class="premium-footer__links" aria-labelledby="FooterHelpTitle-{{ section.id }}"><h2 id="FooterHelpTitle-{{ section.id }}">Help &amp; Support</h2>{% if help_page != blank %}<a href="{{ help_page.url }}">Product &amp; Delivery Help</a>{% endif %}{% if samples_page != blank %}<a href="{{ samples_page.url }}">Request Samples</a>{% endif %}{% if delivery_page != blank %}<a href="{{ delivery_page.url }}">Delivery &amp; Returns</a>{% endif %}{% if guide_page != blank %}<a href="{{ guide_page.url }}">Packaging Size Guide</a>{% endif %}{% if faq_page != blank %}<a href="{{ faq_page.url }}">FAQs</a>{% endif %}{% if returns_page != blank %}<a href="{{ returns_page.url }}">Returns Policy</a>{% endif %}{% if about_page != blank %}<a href="{{ about_page.url }}">About Us</a>{% endif %}{% if contact_page != blank %}<a href="{{ contact_page.url }}">Contact Us</a>{% endif %}</nav><div class="premium-footer__newsletter"><h2>Product updates</h2><p>Subscribe for product updates and practical packaging tips.</p>{% form 'customer' %}<input type="hidden" name="contact[tags]" value="newsletter, packsmart-footer"><div class="premium-footer__form"><input type="email" name="contact[email]" placeholder="Enter your email" aria-label="Email address" autocomplete="email" required><button type="submit" aria-label="Subscribe">›</button></div>{% if form.posted_successfully? %}<p class="premium-footer__message" role="status">Thank you for subscribing.</p>{% endif %}{% if form.errors %}<div class="premium-footer__errors" role="alert">{{ form.errors | default_errors }}</div>{% endif %}<p class="premium-footer__consent">By subscribing, you agree to receive Packsmart product news and packaging tips. You can unsubscribe at any time. See our <a href="/policies/privacy-policy">Privacy Policy</a>.</p>{% endform %}</div></div><div class="premium-footer__legal"><span>© {{ 'now' | date: '%Y' }} Packsmart Solutions Ltd. All rights reserved.<br>Product visuals are illustrative. Colours, dimensions and presentation may vary.</span><span class="premium-footer__legal-links">{% if terms_page != blank %}<a href="{{ terms_page.url }}">Terms</a>{% endif %}<a href="/policies/privacy-policy">Privacy</a></span></div></div></footer>
{% schema %}{"name":"Premium footer","settings":[]}{% endschema %}
