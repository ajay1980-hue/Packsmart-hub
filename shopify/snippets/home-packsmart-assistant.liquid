<aside class="ps-support" data-ps-assistant aria-label="Packsmart customer support">
  <button class="ps-support__launcher" type="button" data-ps-open aria-expanded="false">
    <span aria-hidden="true">✦</span> Ask Packsmart
  </button>
  <section class="ps-support__panel" data-ps-panel hidden>
    <header class="ps-support__header">
      <div><strong>Packsmart Assistant</strong><span>Instant help with orders &amp; packaging</span></div>
      <button type="button" data-ps-close aria-label="Close support">×</button>
    </header>
    <div class="ps-support__messages" data-ps-messages aria-live="polite">
      <p class="ps-support__message is-assistant">Hi! I can help with order tracking, delivery, returns, stock, VAT and pack sizes.</p>
    </div>
    <form class="ps-support__form" data-ps-support-form>
      <div class="ps-support__verify" data-ps-order-fields hidden>
        <label>Order number<input name="orderNumber" autocomplete="off" maxlength="48" placeholder="#1001"></label>
        <label>Checkout email<input name="email" type="email" autocomplete="email" maxlength="254" placeholder="you@example.com"></label>
      </div>
      <label class="visually-hidden" for="PacksmartSupportMessage">Message</label>
      <div class="ps-support__composer">
        <input id="PacksmartSupportMessage" name="message" maxlength="1200" autocomplete="off" placeholder="Where is my order?" required>
        <button type="submit">Send</button>
      </div>
    </form>
  </section>
</aside>
