{% assign mailing = collections['mailing-bags'] %}
{% assign envelopes = collections['bubble-envelopes'] %}
{% assign pouches = collections['bubble-pouches'] %}
<section class="ps-home-section" aria-labelledby="RangeTitle"><div class="wrap"><div class="ps-home-head"><h2 id="RangeTitle">Start with what you need</h2><p>Choose a packaging type, then compare sizes, pack quantities and per-item pricing on the product page.</p></div><div class="ps-home-grid">{% if mailing != blank %}<a class="ps-home-card" href="{{ mailing.url }}"><h3>Mailing Bags</h3><p>Lightweight grey mailers for clothing, textiles and everyday ecommerce orders.</p><strong>Shop mailing bags</strong></a>{% endif %}{% if envelopes != blank %}<a class="ps-home-card" href="{{ envelopes.url }}"><h3>Padded Bubble Envelopes</h3><p>Peel-and-seal padded envelopes for secure everyday postal protection.</p><strong>Shop padded envelopes</strong></a>{% endif %}{% if pouches != blank %}<a class="ps-home-card" href="{{ pouches.url }}"><h3>Self-Seal Bubble Pouches</h3><p>Fast self-seal pouches for delicate products, parts and components.</p><strong>Shop bubble pouches</strong></a>{% endif %}</div></div></section>
